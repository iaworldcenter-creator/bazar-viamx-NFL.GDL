    },
    "sku": {
      "type": "string",
      "description": "Código SKU o número de parte del fabricante/proveedor."
    },
    "proveedor_origen": {
      "type": "string",
      "description": "Nombre comercial del proveedor mayorista, distribuidor o artesano local (ej. 'CT Internacional', 'Intcomex', 'Editorial Alfa', 'Café Sierra de Tapalpa', 'VECTEC')."
    },
    "departamento": {
      "type": "string",
      "description": "Macro-departamento comercial al que pertenece el producto.",
      "enum": [
        "Tecnología & Cómputo VECTEC",
        "Editorial & Lectura",
        "Consumo & Alimentos",
        "Hogar & Herramientas",
        "Coleccionables & Regalos"
      ]
    },
    "categoria": {
      "type": "string",
      "description": "Categoría o subfamilia interna del producto."
    },
    "titulo": {
      "type": "string",
      "description": "Nombre comercial o título completo del producto para despliegue y SEO."
    },
    "especificaciones": {
      "type": ["object", "string"],
      "description": "Atributos técnicos, dimensiones, ingredientes, compatibilidad o descripción estructurada."
    },
    "precio_mayoreo": {
      "type": "number",
      "minimum": 0,
      "description": "Precio neto de adquisición de mayoreo (MXN)."
    },
    "precio_publico": {
      "type": "number",
      "minimum": 0,
      "description": "Precio de venta al público en general (MXN)."
    },
    "unidad": {
      "type": "string",
      "enum": ["pza", "kg", "lote"],
      "description": "Unidad de despacho y venta (pza = pieza unitaria, kg = peso en kilogramos, lote = paquete múltiple)."
    },
    "peso_kg": {
      "type": "number",
      "minimum": 0,
      "description": "Peso neto o volumétrico aproximado del artículo en kilogramos."
    },
    "requiere_flete_especial": {
      "type": "boolean",
      "description": "true si el producto requiere logística especializada o camioneta de carga (por peso > 10 kg, dimensiones no aptas para moto o fragilidad extrema)."
    },
    "marca": {
      "type": "string",
      "description": "Marca registrada del artículo."
    },
    "imagen": {
      "type": "string",
      "description": "URL o ruta relativa de la fotografía del artículo."
    },
    "disponible": {
      "type": "boolean",
      "description": "Disponibilidad activa en inventario."
    }
  },
